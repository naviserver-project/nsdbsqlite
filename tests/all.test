package require tcltest 2.2
namespace import ::tcltest::*
configure {*}$argv
set h [ns_db gethandle sqlite]
ns_db dml $h {CREATE TABLE items (id INTEGER PRIMARY KEY)}
test sqlite-1.1 {prepare error includes SQLite diagnostic} -body {
    set failed [catch {ns_db dml $h {INSERT INTO missing VALUES (1)}}]
    list $failed [string match {*no such table*} [ns_dberrormsg $h]]
} -result {1 1}
test sqlite-1.2 {DML constraint error includes SQLite diagnostic} -body {
    ns_db dml $h {INSERT INTO items VALUES (1)}
    set failed [catch {ns_db dml $h {INSERT INTO items VALUES (1)}}]
    list $failed [string match {*UNIQUE constraint failed*} [ns_dberrormsg $h]]
} -result {1 1}
test sqlite-1.3 {step error is not a successful row} -body {
    set row [ns_db select $h {SELECT abs(-9223372036854775808)}]
    set failed [catch {ns_db getrow $h $row}]
    list $failed [string match {*integer overflow*} [ns_dberrormsg $h]]
} -result {1 1}
test sqlite-1.4 {connection works after failed fetch} -body {
    set row [ns_db 1row $h {SELECT count(*) AS n FROM items}]
    ns_set get $row n
} -result 1
test sqlite-1.5 {normal result completion} -body {
    set row [ns_db select $h {SELECT id FROM items}]
    list [ns_db getrow $h $row] [ns_set get $row id] [ns_db getrow $h $row]
} -result {1 1 0}
test sqlite-2.1 {pool release rolls back unfinished writes} -body {
    ns_db dml $h {BEGIN}
    ns_db dml $h {INSERT INTO items VALUES (2)}
    ns_db releasehandle $h
    set h [ns_db gethandle sqlite]
    set row [ns_db 1row $h {SELECT count(*) AS n FROM items WHERE id = 2}]
    set count [ns_set get $row n]
    ns_db dml $h {BEGIN}
    ns_db dml $h {ROLLBACK}
    set count
} -cleanup {
    ns_db flush $h
    catch {ns_db dml $h {ROLLBACK}}
} -result 0

test sqlite-2.2 {pool release preserves committed writes} -body {
    ns_db dml $h {BEGIN}
    ns_db dml $h {INSERT INTO items VALUES (3)}
    ns_db dml $h {COMMIT}
    ns_db releasehandle $h
    set h [ns_db gethandle sqlite]
    set row [ns_db 1row $h {SELECT count(*) AS n FROM items WHERE id = 3}]
    ns_set get $row n
} -cleanup {
    ns_db flush $h
    catch {ns_db dml $h {ROLLBACK}}
} -result 1

test sqlite-2.3 {explicit reset finalizes active result and rolls back} -body {
    ns_db dml $h {BEGIN}
    ns_db dml $h {INSERT INTO items VALUES (4)}
    set row [ns_db select $h {SELECT id FROM items}]
    ns_db getrow $h $row
    ns_db resethandle $h
    ns_db resethandle $h
    set row [ns_db 1row $h {SELECT count(*) AS n FROM items WHERE id = 4}]
    ns_set get $row n
} -cleanup {
    ns_db flush $h
    catch {ns_db dml $h {ROLLBACK}}
} -result 0

test sqlite-2.4 {pool release rolls back outermost savepoint} -body {
    ns_db dml $h {SAVEPOINT outer_tx}
    ns_db dml $h {INSERT INTO items VALUES (5)}
    ns_db releasehandle $h
    set h [ns_db gethandle sqlite]
    set row [ns_db 1row $h {SELECT count(*) AS n FROM items WHERE id = 5}]
    ns_set get $row n
} -cleanup {
    ns_db flush $h
    catch {ns_db dml $h {ROLLBACK}}
} -result 0

test sqlite-2.5 {pool release clears unfinished read transaction} -body {
    ns_db dml $h {BEGIN}
    set row [ns_db select $h {SELECT id FROM items}]
    ns_db getrow $h $row
    ns_db releasehandle $h
    set h [ns_db gethandle sqlite]
    ns_db dml $h {BEGIN}
    ns_db dml $h {ROLLBACK}
} -cleanup {
    ns_db flush $h
    catch {ns_db dml $h {ROLLBACK}}
} -result {}

ns_db dml $h {CREATE TABLE counts (id INTEGER PRIMARY KEY, value INTEGER)}
proc rowCounts {h} {
    list [ns_db rowcount $h] [ns_sqlite rows_affected $h]
}
test sqlite-3.1 {INSERT UPDATE DELETE report direct affected rows} -body {
    ns_db dml $h {INSERT INTO counts VALUES (1, 10), (2, 20), (3, 30)}
    set result [list [rowCounts $h]]
    ns_db flush $h
    lappend result [rowCounts $h]
    ns_db dml $h {UPDATE counts SET value = value + 1 WHERE id <= 2}
    lappend result [rowCounts $h]
    ns_db dml $h {DELETE FROM counts WHERE id = 3}
    lappend result [rowCounts $h]
} -result {{3 3} {3 3} {2 2} {1 1}}

test sqlite-3.2 {zero-match DML clears previous count} -body {
    ns_db dml $h {UPDATE counts SET value = 0 WHERE id = 99}
    rowCounts $h
} -result {0 0}

test sqlite-3.3 {SELECT counts fetched rows through result completion} -body {
    ns_db dml $h {UPDATE counts SET value = value + 1}
    set row [ns_db select $h {SELECT id FROM counts ORDER BY id}]
    set result [list [rowCounts $h]]
    ns_db getrow $h $row
    lappend result [rowCounts $h]
    ns_db getrow $h $row
    lappend result [rowCounts $h]
    ns_db getrow $h $row
    lappend result [rowCounts $h]
} -result {{0 0} {1 0} {2 0} {2 0}}

test sqlite-3.4 {empty SELECT and partial flush preserve fetched counts} -body {
    set row [ns_db select $h {SELECT id FROM counts WHERE id = 99}]
    ns_db getrow $h $row
    set result [list [rowCounts $h]]
    set row [ns_db select $h {SELECT id FROM counts}]
    ns_db getrow $h $row
    ns_db flush $h
    lappend result [rowCounts $h]
} -result {{0 0} {1 0}}

test sqlite-3.5 {DDL and transaction commands do not reuse DML count} -body {
    ns_db dml $h {UPDATE counts SET value = value + 1}
    ns_db dml $h {CREATE TABLE count_ddl (id INTEGER)}
    set result [list [rowCounts $h]]
    ns_db dml $h {BEGIN}
    lappend result [rowCounts $h]
    ns_db dml $h {COMMIT}
    lappend result [rowCounts $h]
} -result {{0 0} {0 0} {0 0}}

test sqlite-3.6 {RETURNING reports affected count after completion} -body {
    set row [ns_db select $h {UPDATE counts SET value = value + 1 RETURNING id}]
    while {[ns_db getrow $h $row]} {}
    rowCounts $h
} -result {2 2}

test sqlite-3.7 {trigger changes are excluded from direct affected count} -body {
    ns_db dml $h {CREATE TABLE audit (id INTEGER)}
    ns_db dml $h {CREATE TRIGGER counts_audit AFTER UPDATE ON counts
                 BEGIN INSERT INTO audit VALUES (new.id); END}
    ns_db dml $h {UPDATE counts SET value = value + 1}
    rowCounts $h
} -result {2 2}

test sqlite-3.8 {errors clear previous operation counts} -body {
    ns_db dml $h {UPDATE counts SET value = value + 1}
    catch {ns_db dml $h {INSERT INTO counts VALUES (1, 0)}}
    set result [list [rowCounts $h]]
    catch {ns_db dml $h {SELECT FROM}}
    lappend result [rowCounts $h]
} -result {{0 0} {0 0}}

test sqlite-3.9 {pool reset clears both counters for next borrower} -body {
    ns_db dml $h {UPDATE counts SET value = value + 1}
    ns_db releasehandle $h
    set h [ns_db gethandle sqlite]
    rowCounts $h
} -result {0 0}

test sqlite-4.1 {ns_db info reports runtime client and engine versions} -body {
    set info [ns_db info $h]
    lassign [split [ns_sqlite version $h] .] major minor patch
    set expected [expr {$major * 1000000 + $minor * 1000 + $patch}]
    list [expr {[dict get $info clientversion] == $expected}] \
         [expr {[dict get $info serverversion] == $expected}] \
         [dict get $info type] [dict get $info pool]
} -result {1 1 sqlite sqlite}

test sqlite-4.2 {version introspection leaves pending results and counts intact} -body {
    set row [ns_db select $h {SELECT 10 AS n UNION ALL SELECT 20}]
    ns_db getrow $h $row
    set before [rowCounts $h]
    ns_db info $h
    set after [rowCounts $h]
    ns_db getrow $h $row
    set value [ns_set get $row n]
    set done [ns_db getrow $h $row]
    list $before $after $value $done [ns_db rowcount $h]
} -result {{1 0} {1 0} 20 0 2}

test sqlite-5.1 {bind after reset has a clear error} -body {
    ns_db resethandle $h
    list [catch {ns_db bindrow $h}] [ns_dberrormsg $h]
} -result {1 {no result data for row}}

test sqlite-5.2 {bind after prepare failure does not dereference freed context} -body {
    catch {ns_db exec $h {SELECT FROM}}
    list [catch {ns_db bindrow $h}] [ns_dberrormsg $h]
} -result {1 {no result data for row}}

test sqlite-5.3 {bind and fetch after result completion are rejected} -body {
    set row [ns_db select $h {SELECT 1 AS n}]
    ns_db getrow $h $row
    ns_db getrow $h $row
    list [catch {ns_db bindrow $h}] [catch {ns_db getrow $h $row}] \
         [ns_dberrormsg $h]
} -result {1 1 {no rows waiting to fetch}}

test sqlite-5.4 {cancel and flush are idempotent and prevent further fetching} -body {
    set row [ns_db select $h {SELECT 1 AS n UNION ALL SELECT 2}]
    ns_db getrow $h $row
    ns_db cancel $h
    ns_db cancel $h
    ns_db flush $h
    set result [list [catch {ns_db bindrow $h}] [catch {ns_db getrow $h $row}]]
    set row [ns_db 1row $h {SELECT 3 AS n}]
    lappend result [ns_set get $row n]
} -result {1 1 3}

test sqlite-5.5 {wrong row-set width is rejected before consuming a result} -body {
    set row [ns_db select $h {SELECT 10 AS n, 20 AS m}]
    set wrong [ns_set create wrong n {}]
    try {
        set result [list [catch {ns_db getrow $h $wrong}] [ns_dberrormsg $h]]
        ns_db getrow $h $row
        lappend result [ns_set get $row n] [ns_set get $row m]
        ns_db flush $h
        set result
    } finally {
        ns_set free $wrong
    }
} -result {1 {row set does not match result columns} 10 20}

test sqlite-5.6 {step diagnostic survives finalization and connection recovers} -body {
    set row [ns_db select $h {SELECT abs(-9223372036854775808)}]
    catch {ns_db getrow $h $row}
    set diagnostic [ns_dberrormsg $h]
    ns_db flush $h
    ns_db cancel $h
    set row [ns_db 1row $h {SELECT 9 AS n}]
    list [string match {*integer overflow*} $diagnostic] [ns_set get $row n]
} -result {1 9}

ns_db dml $h {CREATE TABLE sp_items (id INTEGER PRIMARY KEY)}
test sqlite-6.1 {sp_start prepares DML without executing it} -body {
    set started [ns_db sp_start $h {INSERT INTO sp_items VALUES (1)}]
    ns_db cancel $h
    set row [ns_db 1row $h {SELECT count(*) AS n FROM sp_items}]
    list $started [ns_set get $row n]
} -result {0 0}

test sqlite-6.2 {sp_exec executes DML once and updates row counts} -body {
    ns_db sp_start $h {INSERT INTO sp_items VALUES (1), (2)}
    set executed [ns_db sp_exec $h]
    set counts [rowCounts $h]
    set repeated [catch {ns_db sp_exec $h}]
    set row [ns_db 1row $h {SELECT count(*) AS n FROM sp_items}]
    list $executed $counts $repeated [ns_set get $row n]
} -result {NS_DML {2 2} 1 2}

test sqlite-6.3 {sp_exec activates a result for bind and fetch} -body {
    ns_db sp_start $h {SELECT id FROM sp_items ORDER BY id}
    set before [catch {ns_db bindrow $h}]
    set executed [ns_db sp_exec $h]
    set repeated [catch {ns_db sp_exec $h}]
    set row [ns_db bindrow $h]
    set values {}
    while {[ns_db getrow $h $row]} {lappend values [ns_set get $row id]}
    list $before $executed $repeated $values [ns_db rowcount $h]
} -result {1 NS_ROWS 1 {1 2} 2}

test sqlite-6.4 {sp_exec rejects missing pending execution} -body {
    ns_db resethandle $h
    list [catch {ns_db sp_exec $h}] [ns_dberrormsg $h]
} -result {1 {no prepared SQL statement waiting for sp_exec}}

test sqlite-6.5 {sp_start rejects invalid empty and parameterized SQL} -body {
    set failed [catch {ns_db sp_start $h {SELECT FROM}}]
    set parse [string match {*syntax error*} [ns_dberrormsg $h]]
    set empty [catch {ns_db sp_start $h { -- comment only}}]
    set emptyMessage [ns_dberrormsg $h]
    set parameter [catch {ns_db sp_start $h {SELECT :value}}]
    list $failed $parse $empty $emptyMessage $parameter [ns_dberrormsg $h]
} -result {1 1 1 {no SQL statement for sp_start} 1 {sp_start does not support SQL parameters}}

test sqlite-6.6 {DML errors occur at sp_exec and consume pending execution} -body {
    set started [ns_db sp_start $h {INSERT INTO sp_items VALUES (1)}]
    set failed [catch {ns_db sp_exec $h}]
    set diagnostic [string match {*UNIQUE constraint failed*} [ns_dberrormsg $h]]
    list $started $failed $diagnostic [rowCounts $h] [catch {ns_db sp_exec $h}]
} -result {0 1 1 {0 0} 1}

test sqlite-6.7 {replacement cancels prepared shim without executing it} -body {
    ns_db sp_start $h {INSERT INTO sp_items VALUES (3)}
    ns_db sp_start $h {INSERT INTO sp_items VALUES (4)}
    ns_db sp_exec $h
    set row [ns_db 1row $h {SELECT group_concat(id, ',') AS ids FROM
                         (SELECT id FROM sp_items ORDER BY id)}]
    ns_set get $row ids
} -result {1,2,4}

test sqlite-6.8 {ordinary execution invalidates shim without consuming its result} -body {
    ns_db sp_start $h {INSERT INTO sp_items VALUES (5)}
    set row [ns_db select $h {SELECT count(*) AS n FROM sp_items}]
    set failed [catch {ns_db sp_exec $h}]
    ns_db getrow $h $row
    set count [ns_set get $row n]
    ns_db flush $h
    list $failed $count
} -result {1 3}

test sqlite-6.9 {pool release cancels a prepared shim} -body {
    ns_db sp_start $h {INSERT INTO sp_items VALUES (6)}
    ns_db releasehandle $h
    set h [ns_db gethandle sqlite]
    set failed [catch {ns_db sp_exec $h}]
    set row [ns_db 1row $h {SELECT count(*) AS n FROM sp_items}]
    list $failed [ns_set get $row n]
} -result {1 3}

test sqlite-6.10 {RETURNING uses the same fetch and affected-row accounting} -body {
    ns_db sp_start $h {UPDATE sp_items SET id = id + 10 RETURNING id}
    set executed [ns_db sp_exec $h]
    set row [ns_db bindrow $h]
    while {[ns_db getrow $h $row]} {}
    list $executed [rowCounts $h]
} -result {NS_ROWS {3 3}}

ns_db releasehandle $h
set failed $::tcltest::numTests(Failed)
cleanupTests
if {$failed} {ns_shutdown -restart} else {ns_shutdown}
vwait forever
